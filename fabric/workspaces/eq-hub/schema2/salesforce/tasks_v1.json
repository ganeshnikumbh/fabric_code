{
  "table_name": "task",
  "description": "Salesforce Task object — one row per Task (activity) record from the SOQL query. The API returns paginated page envelopes (totalSize/done/nextRecordsUrl/records); records are extracted from each page's 'records' array and flattened. attributes.type/url carry SObject metadata. Standard fields cover core task, call-center, recurrence, and relationship data. Custom fields (suffix _c) are org-specific extensions including legacy migration fields, follow-up tracking, maps integration, and SalesVue fields. WhoId/WhatId are polymorphic relationship IDs. ActivityDate and recurrence date fields are ISO date strings stored as-is in bronze. Timestamps (CompletedDateTime, ReminderDateTime, CreatedDate, LastModifiedDate) are ISO UTC strings stored as-is in bronze.",
  "source_path": "records",
  "context_fields": ["start_date", "end_date", "record_type", "source"],
