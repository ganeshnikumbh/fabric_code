{
  "table_name": "aar",
  "description": "Webex Agent Activity Report — exploded to one row per activity event. Parent agent/channel fields prefixed; activity fields are direct. agent_session_id links back to the parent ASR session.",
  "source_path": "result.data",
  "array_explode_path": "channelInfo.$0.activities.nodes",
  "context_fields": ["start_date", "end_date", "record_type", "source"],
  "fields": [
    {"column": "agent_id", "source": "__parent__.agentId", "type": "string"},
    {"column": "agent_name", "source": "__parent__.agentName", "type": "string"},
    {"column": "agent_session_id", "source": "__parent__.agentSessionId", "type": "string"},
    {"column": "site_id", "source": "__parent__.siteId", "type": "string"},
    {"column": "site_name", "source": "__parent__.siteName", "type": "string"},
    {"column": "team_id", "source": "__parent__.teamId", "type": "string"},
    {"column": "team_name", "source": "__parent__.teamName", "type": "string"},
    {"column": "user_login_id", "source": "__parent__.userLoginId", "type": "string"},
    {"column": "channel_id", "source": "__parent__.channelInfo.$0.channelId", "type": "string"},
    {"column": "channel_type", "source": "__parent__.channelInfo.$0.channelType", "type": "string"},
    {"column": "channel_sub_type", "source": "__parent__.channelInfo.$0.subChannelType", "type": "string"},
    {"column": "channel_agent_phone_number", "source": "__parent__.channelInfo.$0.agentPhoneNumber", "type": "string"},
    {"column": "id", "source": "id", "type": "string"},
    {"column": "state", "source": "state", "type": "string"},
    {"column": "start_time", "source": "startTime", "type": "integer"},
    {"column": "end_time", "source": "endTime", "type": "integer"},
    {"column": "duration", "source": "duration", "type": "integer"},
    {"column": "is_current_activity", "source": "isCurrentActivity", "type": "boolean"},
    {"column": "is_login_activity", "source": "isLoginActivity", "type": "boolean"},
    {"column": "is_logout_activity", "source": "isLogoutActivity", "type": "boolean"},
    {"column": "is_outdial", "source": "isOutdial", "type": "boolean"},
    {"column": "task_id", "source": "taskId", "type": "string"},
    {"column": "changed_by_id", "source": "changedById", "type": "string"},
    {"column": "changed_by_name", "source": "changedByName", "type": "string"},
    {"column": "contact_assignment_type", "source": "contactAssignmentType", "type": "string"},
    {"column": "outbound_type", "source": "outboundType", "type": "string"},
    {"column": "queue_id", "source": "queue.id", "type": "string"},
    {"column": "queue_name", "source": "queue.name", "type": "string"},
    {"column": "idle_code_id", "source": "idleCode.id", "type": "string"},
    {"column": "idle_code_name", "source": "idleCode.name", "type": "string"},
    {"column": "wrapup_code_id", "source": "wrapupCode.id", "type": "string"},
    {"column": "wrapup_code_name", "source": "wrapupCode.name", "type": "string"}
  ]
}
